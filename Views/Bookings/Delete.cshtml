@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-trash"></i> Delete Booking
        </h1>
        <p class="lead text-white">Are you sure you want to delete this booking?</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Warning: This action cannot be undone
                    </h5>
                </div>
                <div class="card-body">
                    <h4 class="mb-4">Booking #@Model.BookingId Details</h4>

                    <dl class="row">
                        <dt class="col-sm-4">Event</dt>
                        <dd class="col-sm-8">@Model.Event?.EventName</dd>

                        <dt class="col-sm-4">Venue</dt>
                        <dd class="col-sm-8">@Model.Venue?.VenueName</dd>

                        <dt class="col-sm-4">Start Date</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToString("f")</dd>

                        <dt class="col-sm-4">End Date</dt>
                        <dd class="col-sm-8">@Model.EndDate.ToString("f")</dd>

                        <dt class="col-sm-4">Customer</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.CustomerName))
                            {
                                @Model.CustomerName
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.BookingStatus == "Confirmed" ? "bg-success" : Model.BookingStatus == "Cancelled" ? "bg-danger" : "bg-warning")">
                                @Model.BookingStatus
                            </span>
                        </dd>
                    </dl>

                    <form asp-action="Delete">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <input type="hidden" asp-for="BookingId" />
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
