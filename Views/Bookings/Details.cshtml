@model EventEase.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-bookmark-check"></i> Booking #@Model.BookingId
        </h1>
        <p class="lead">
            <span class="badge @(Model.BookingStatus == "Confirmed" ? "bg-success" : "bg-warning")">
                @Model.BookingStatus
            </span>
        </p>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle"></i> Booking Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Booking ID</dt>
                        <dd class="col-sm-8">#@Model.BookingId</dd>

                        <dt class="col-sm-4">Event</dt>
                        <dd class="col-sm-8">
                            <a href="/Events/Details/@Model.EventId" class="text-decoration-none fw-bold">
                                @Model.Event?.EventName
                            </a>
                            <br />
                            <small class="text-muted">Scheduled: @Model.Event?.EventDate.ToString("f")</small>
                        </dd>

                        <dt class="col-sm-4">Venue</dt>
                        <dd class="col-sm-8">
                            <a href="/Venues/Details/@Model.VenueId" class="text-decoration-none">
                                <span class="badge bg-info">
                                    <i class="bi bi-building"></i> @Model.Venue?.VenueName
                                </span>
                            </a>
                            <br />
                            <small class="text-muted">@Model.Venue?.Location</small>
                            <br />
                            <small class="text-muted">Capacity: @Model.Venue?.Capacity</small>
                        </dd>

                        <dt class="col-sm-4">Booking Period</dt>
                        <dd class="col-sm-8">
                            <div class="p-2 bg-light rounded">
                                <div><strong>Start:</strong> @Model.StartDate.ToString("f")</div>
                                <div><strong>End:</strong> @Model.EndDate.ToString("f")</div>
                                <div class="mt-1">
                                    <small class="text-muted">
                                        Duration: @(Model.EndDate - Model.StartDate).TotalHours.ToString("F1") hours
                                    </small>
                                </div>
                            </div>
                        </dd>

                        <dt class="col-sm-4">Booking Date</dt>
                        <dd class="col-sm-8">@Model.BookingDate.ToString("f")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.BookingStatus == "Confirmed" ? "bg-success" : Model.BookingStatus == "Cancelled" ? "bg-danger" : "bg-warning")">
                                @Model.BookingStatus
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person"></i> Customer Information
                    </h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.CustomerName) || !string.IsNullOrEmpty(Model.CustomerEmail) || !string.IsNullOrEmpty(Model.CustomerPhone))
                    {
                        <dl class="row mb-0">
                            @if (!string.IsNullOrEmpty(Model.CustomerName))
                            {
                                <dt class="col-sm-5">Name</dt>
                                <dd class="col-sm-7">@Model.CustomerName</dd>
                            }

                            @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                            {
                                <dt class="col-sm-5">Email</dt>
                                <dd class="col-sm-7">
                                    <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                                </dd>
                            }

                            @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                            {
                                <dt class="col-sm-5">Phone</dt>
                                <dd class="col-sm-7">@Model.CustomerPhone</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-person-slash" style="font-size: 2rem;"></i>
                            <p class="mt-2">No customer information provided</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-gear"></i> Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Edit Booking
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.BookingId" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Cancel/Delete Booking
                        </a>
                        <hr />
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
