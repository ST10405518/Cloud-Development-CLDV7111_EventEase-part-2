@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Booking Calendar";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-calendar-week"></i> Booking Calendar
        </h1>
        <p class="lead">View all bookings in a timeline format</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Booking
        </a>
    </div>

    @if (Model.Any())
    {
        var groupedByMonth = Model.GroupBy(b => new { b.StartDate.Year, b.StartDate.Month }).OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month);

        foreach (var monthGroup in groupedByMonth)
        {
            var monthName = new DateTime(monthGroup.Key.Year, monthGroup.Key.Month, 1).ToString("MMMM yyyy");
            
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-calendar-month"></i> @monthName
                    </h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Event</th>
                                    <th>Venue</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in monthGroup.OrderBy(b => b.StartDate))
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-bold">@booking.StartDate.ToString("ddd, MMM dd")</span>
                                        </td>
                                        <td>
                                            @booking.StartDate.ToString("HH:mm")
                                            <span class="text-muted">-</span>
                                            @booking.EndDate.ToString("HH:mm")
                                        </td>
                                        <td>
                                            <a href="/Events/Details/@booking.EventId" class="text-decoration-none fw-bold">
                                                @booking.Event?.EventName
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">
                                                <i class="bi bi-building"></i> @booking.Venue?.VenueName
                                            </span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(booking.CustomerName))
                                            {
                                                <small>@booking.CustomerName</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @(booking.BookingStatus == "Confirmed" ? "bg-success" : booking.BookingStatus == "Cancelled" ? "bg-danger" : "bg-warning")">
                                                @booking.BookingStatus
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-outline-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@booking.BookingId" class="btn btn-outline-warning">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x" style="font-size: 5rem; color: #ccc;"></i>
            <h3 class="mt-3 text-muted">No Bookings Found</h3>
            <p class="text-muted">The calendar is empty. Create your first booking to get started.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Booking
            </a>
        </div>
    }
</div>
