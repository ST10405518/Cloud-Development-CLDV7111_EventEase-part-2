@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-bookmark-check"></i> Bookings
        </h1>
        <p class="lead">Manage venue bookings and reservations</p>
    </div>
</div>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Bookings</h2>
        <div class="btn-group">
            <a asp-action="Calendar" class="btn btn-outline-primary">
                <i class="bi bi-calendar-week"></i> Calendar View
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> New Booking
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-funnel"></i> Advanced Filters</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Search</label>
                        <input type="text" name="searchString" class="form-control" placeholder="Event, venue, or customer..." value="@ViewData["CurrentFilter"]" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Event Type</label>
                        <select name="eventTypeId" class="form-select" asp-items="@ViewData["EventTypes"] as SelectList">
                            <option value="">All Types</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Start Date</label>
                        <input type="date" name="startDate" class="form-control" value="@(ViewData["StartDate"] != null ? ((DateTime)ViewData["StartDate"]).ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">End Date</label>
                        <input type="date" name="endDate" class="form-control" value="@(ViewData["EndDate"] != null ? ((DateTime)ViewData["EndDate"]).ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Venue Available</label>
                        <select name="venueAvailable" class="form-select">
                            <option value="">All</option>
                            <option value="true" selected="@(ViewData["VenueAvailable"]?.ToString() == "True")">Available</option>
                            <option value="false" selected="@(ViewData["VenueAvailable"]?.ToString() == "False")">Not Available</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Filter
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <div class="table-container">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Booking ID</th>
                        <th>Event</th>
                        <th>Event Type</th>
                        <th>Venue</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.BookingId</td>
                            <td class="fw-bold">@item.Event?.EventName</td>
                            <td>
                                <span class="badge bg-secondary">
                                    <i class="bi bi-tag"></i> @item.Event?.EventType?.EventTypeName
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info">
                                    <i class="bi bi-building"></i> @item.Venue?.VenueName
                                </span>
                            </td>
                            <td>@item.StartDate.ToString("g")</td>
                            <td>@item.EndDate.ToString("g")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CustomerName))
                                {
                                    <div>
                                        <i class="bi bi-person"></i> @item.CustomerName
                                        @if (!string.IsNullOrEmpty(item.CustomerPhone))
                                        {
                                            <br />
                                
                                            <small class="text-muted">@item.CustomerPhone</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.BookingStatus == "Confirmed" ? "bg-success" : "bg-warning")">
                                    @item.BookingStatus
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.BookingId" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-bookmark-x" style="font-size: 5rem; color: #ccc;"></i>
            <h3 class="mt-3 text-muted">No Bookings Found</h3>
            <p class="text-muted">Get started by creating your first booking.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Booking
            </a>
        </div>
    }
</div>
