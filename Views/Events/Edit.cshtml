@model EventEase.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-pencil-square"></i> Edit Event
        </h1>
        <p class="lead">Update event details</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <input type="hidden" asp-for="EventId" />
                        <input type="hidden" asp-for="CreatedDate" />

                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label"></label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VenueId" class="form-label">Venue</label>
                            <select asp-for="VenueId" class="form-select" asp-items="@(ViewData["VenueId"] as SelectList)"></select>
                            <span asp-validation-for="VenueId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventTypeId" class="form-label">Event Type</label>
                            <select asp-for="EventTypeId" class="form-select" asp-items="@(ViewData["EventTypeId"] as SelectList)"></select>
                            <span asp-validation-for="EventTypeId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
