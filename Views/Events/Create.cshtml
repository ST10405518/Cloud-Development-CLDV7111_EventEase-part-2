@model EventEase.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-calendar-plus"></i> Create New Event
        </h1>
        <p class="lead">Schedule a new event</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="EventName" class="form-label"></label>
                            <input asp-for="EventName" class="form-control" />
                            <span asp-validation-for="EventName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="VenueId" class="form-label">Venue (Optional)</label>
                            <select asp-for="VenueId" class="form-select" asp-items="ViewBag.VenueId">
                                <option value="">-- Select Venue --</option>
                            </select>
                            <span asp-validation-for="VenueId" class="text-danger"></span>
                            <div class="form-text">You can create a booking later to assign this event to a venue</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Event
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
