@model EventEase.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-calendar-event"></i> @Model.EventName
        </h1>
        <p class="lead">@Model.EventDate.ToString("dddd, MMMM dd, yyyy 'at' HH:mm")</p>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle"></i> Event Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.EventName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.EventName)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.EventDate)</dt>
                        <dd class="col-sm-8">@Model.EventDate.ToString("f")</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Venue)</dt>
                        <dd class="col-sm-8">
                            @if (Model.Venue != null)
                            {
                                <a href="/Venues/Details/@Model.VenueId" class="text-decoration-none">
                                    <span class="badge bg-info">
                                        <i class="bi bi-building"></i> @Model.Venue.VenueName
                                    </span>
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">No Venue Assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Description)</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @Html.DisplayFor(model => model.Description)
                            }
                            else
                            {
                                <span class="text-muted">No description provided</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CreatedDate)</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-bookmark-check"></i> Bookings for this Event
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Bookings != null && Model.Bookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Venue</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model.Bookings)
                                    {
                                        <tr>
                                            <td>@booking.Venue?.VenueName</td>
                                            <td>@booking.StartDate.ToString("g")</td>
                                            <td>@booking.EndDate.ToString("g")</td>
                                            <td>
                                                <span class="badge @(booking.BookingStatus == "Confirmed" ? "bg-success" : "bg-warning")">
                                                    @booking.BookingStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-2">No bookings for this event yet.</p>
                            <a href="/Bookings/Create" class="btn btn-sm btn-primary">Create a Booking</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
