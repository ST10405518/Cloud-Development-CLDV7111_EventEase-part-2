@model EventEase.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-trash"></i> Delete Event
        </h1>
        <p class="lead text-white">Are you sure you want to delete this event?</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Warning
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.HasBookings != null && (bool)ViewBag.HasBookings)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle"></i> <strong>Cannot Delete!</strong>
                            This event has existing bookings. Please remove all bookings associated with this event before deleting it.
                        </div>
                    }

                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.EventName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.EventName)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.EventDate)</dt>
                        <dd class="col-sm-8">@Model.EventDate.ToString("f")</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Venue)</dt>
                        <dd class="col-sm-8">
                            @if (Model.Venue != null)
                            {
                                <span class="badge bg-info">@Model.Venue.VenueName</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">No Venue</span>
                            }
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Description)</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                @(Model.Description.Length > 100 ? Model.Description.Substring(0, 100) + "..." : Model.Description)
                            }
                            else
                            {
                                <span class="text-muted">No description</span>
                            }
                        </dd>
                    </dl>

                    @if (ViewBag.HasBookings != null && (bool)ViewBag.HasBookings)
                    {
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button class="btn btn-danger" disabled>
                                <i class="bi bi-trash"></i> Delete (Blocked)
                            </button>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Delete">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Back to List
                                </a>
                                <input type="hidden" asp-for="EventId" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
