@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-4 fw-bold">
            <i class="bi bi-shield-lock"></i> Privacy Policy
        </h1>
        <p class="lead">How EventEase handles your data</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-body">
                    <h3>EventEase Privacy Policy</h3>
                    <p class="text-muted">Last updated: March 2026</p>

                    <h5>1. Data Collection</h5>
                    <p>
                        EventEase collects and stores the following information:
                    </p>
                    <ul>
                        <li>Venue details (names, locations, capacity, images)</li>
                        <li>Event information (names, dates, descriptions)</li>
                        <li>Booking details (dates, customer information)</li>
                    </ul>

                    <h5>2. Data Security</h5>
                    <p>
                        All data is stored securely in Azure SQL Database with industry-standard encryption.
                        We implement regular backups and access controls to protect your information.
                    </p>

                    <h5>3. Data Usage</h5>
                    <p>
                        Customer information is used solely for managing venue bookings and events.
                        We do not share or sell customer data to third parties.
                    </p>

                    <h5>4. Contact</h5>
                    <p>
                        For any privacy concerns, please contact EventEase administration.
                    </p>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
