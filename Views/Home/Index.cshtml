@model IEnumerable<EventEase.Models.Booking>
@{
    ViewData["Title"] = "Dashboard";
}

<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold">Welcome to EventEase</h1>
                <p class="lead">Your comprehensive venue booking management system</p>
            </div>
            <div class="col-md-4 text-center">
                <i class="bi bi-calendar-event" style="font-size: 6rem; opacity: 0.8;"></i>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stats-card">
                <div class="stats-number">@ViewBag.VenueCount</div>
                <p class="mb-0 text-muted">
                    <i class="bi bi-building"></i> Total Venues
                </p>
                <a href="/Venues" class="btn btn-sm btn-outline-primary mt-2">Manage Venues</a>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stats-card">
                <div class="stats-number">@ViewBag.EventCount</div>
                <p class="mb-0 text-muted">
                    <i class="bi bi-calendar3"></i> Total Events
                </p>
                <a href="/Events" class="btn btn-sm btn-outline-primary mt-2">Manage Events</a>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stats-card">
                <div class="stats-number">@ViewBag.BookingCount</div>
                <p class="mb-0 text-muted">
                    <i class="bi bi-bookmark-check"></i> Total Bookings
                </p>
                <a href="/Bookings" class="btn btn-sm btn-outline-primary mt-2">Manage Bookings</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-calendar-check"></i> Upcoming Bookings
                    </h5>
                    <a href="/Bookings/Create" class="btn btn-light btn-sm">
                        <i class="bi bi-plus-circle"></i> New Booking
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Venue</th>
                                        <th>Date & Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model)
                                    {
                                        <tr>
                                            <td>
                                                <a href="/Bookings/Details/@booking.BookingId" class="text-decoration-none fw-bold">
                                                    @booking.Event?.EventName
                                                </a>
                                            </td>
                                            <td>@booking.Venue?.VenueName</td>
                                            <td>
                                                @booking.StartDate.ToString("MMM dd, yyyy HH:mm")
                                                <br />
                                                <small class="text-muted">to</small>
                                                <br />
                                                @booking.EndDate.ToString("MMM dd, yyyy HH:mm")
                                            </td>
                                            <td>
                                                <span class="badge @(booking.BookingStatus == "Confirmed" ? "bg-success" : "bg-warning")">
                                                    @booking.BookingStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-2">No upcoming bookings found.</p>
                            <a href="/Bookings/Create" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Create Your First Booking
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning-charge"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Venues/Create" class="btn btn-outline-primary">
                            <i class="bi bi-building-add"></i> Add New Venue
                        </a>
                        <a href="/Events/Create" class="btn btn-outline-success">
                            <i class="bi bi-calendar-plus"></i> Add New Event
                        </a>
                        <a href="/Bookings/Create" class="btn btn-outline-info">
                            <i class="bi bi-bookmark-plus"></i> Create Booking
                        </a>
                        <a href="/Bookings/Calendar" class="btn btn-outline-dark">
                            <i class="bi bi-calendar-week"></i> View Calendar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
