@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-trash"></i> Delete Venue
        </h1>
        <p class="lead text-white">Are you sure you want to delete this venue?</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Warning
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.HasBookings != null && (bool)ViewBag.HasBookings)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle"></i> <strong>Cannot Delete!</strong> 
                            This venue has existing bookings. Please remove all bookings associated with this venue before deleting it.
                        </div>
                    }

                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.VenueName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.VenueName)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Location)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Location)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Capacity)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Capacity)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CreatedDate)</dd>
                    </dl>

                    @if (ViewBag.HasBookings != null && (bool)ViewBag.HasBookings)
                    {
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to List
                            </a>
                            <button class="btn btn-danger" disabled>
                                <i class="bi bi-trash"></i> Delete (Blocked)
                            </button>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Delete">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Back to List
                                </a>
                                <input type="hidden" asp-for="VenueId" />
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Confirm Delete
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
