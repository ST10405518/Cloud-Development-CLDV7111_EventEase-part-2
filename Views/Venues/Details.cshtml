@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-building"></i> @Model.VenueName
        </h1>
        <p class="lead">@Model.Location</p>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.VenueName" style="max-height: 300px; object-fit: cover;">
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 300px;">
                        <i class="bi bi-building" style="font-size: 6rem; color: #ccc;"></i>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">Venue Information</h5>
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.VenueName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.VenueName)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Location)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Location)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Capacity)</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-info">
                                <i class="bi bi-people"></i> @Html.DisplayFor(model => model.Capacity)
                            </span>
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CreatedDate)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.CreatedDate)</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-bookmark-check"></i> Bookings for this Venue
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Bookings != null && Model.Bookings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Event</th>
                                        <th>Start</th>
                                        <th>End</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var booking in Model.Bookings)
                                    {
                                        <tr>
                                            <td>@booking.Event?.EventName</td>
                                            <td>@booking.StartDate.ToString("g")</td>
                                            <td>@booking.EndDate.ToString("g")</td>
                                            <td>
                                                <span class="badge @(booking.BookingStatus == "Confirmed" ? "bg-success" : "bg-warning")">
                                                    @booking.BookingStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                            <p class="mt-2">No bookings for this venue yet.</p>
                            <a href="/Bookings/Create" class="btn btn-sm btn-primary">Create a Booking</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
